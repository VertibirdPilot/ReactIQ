# Cell 1: imports
import pandas as pd
import matplotlib.pyplot as plt
from wordcloud import WordCloud
from dataset_loader import load_dataset

# Cell 2: load
df = load_dataset("dataset.csv")
df.head()

# Cell 3: basic stats
print("Rows:", len(df))
print(df['label'].value_counts())

# Cell 4: text length distribution
df['length'] = df['text'].str.split().apply(len)
df['length'].hist(bins=50)
plt.title("Text length distribution")
plt.xlabel("Words in text")

# Cell 5: wordcloud for positives & negatives
pos_text = " ".join(df[df['label']==1]['text'].astype(str).tolist())
neg_text = " ".join(df[df['label']==0]['text'].astype(str).tolist())

wc_pos = WordCloud(width=800, height=400).generate(pos_text)
plt.figure(figsize=(12,6)); plt.imshow(wc_pos); plt.axis("off"); plt.title("Positive wordcloud")

wc_neg = WordCloud(width=800, height=400).generate(neg_text)
plt.figure(figsize=(12,6)); plt.imshow(wc_neg); plt.axis("off"); plt.title("Negative wordcloud")